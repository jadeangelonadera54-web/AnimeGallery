<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:AnimeGallery.ViewModels"
             xmlns:models="clr-namespace:AnimeGallery.Models"
             x:Class="AnimeGallery.MainPage"
             Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0B0715" Offset="0.0" />
            <GradientStop Color="#150E28" Offset="0.4" />
            <GradientStop Color="#1E1238" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">

        <!-- 1. Header Bar -->
        <Grid Grid.Row="0"
              Padding="18,16,18,10"
              ColumnDefinitions="*,Auto"
              BackgroundColor="#120A22">

            <VerticalStackLayout Grid.Column="0" Spacing="2">
                <HorizontalStackLayout Spacing="8">
                    <Label Text="❖"
                           TextColor="#C77DFF"
                           FontSize="18"
                           VerticalOptions="Center" />
                    <Label Text="ANIME ARCHIVE"
                           TextColor="#FFFFFF"
                           FontSize="20"
                           FontAttributes="Bold"
                           CharacterSpacing="1.2"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Label Text="Explore iconic anime heroes &amp; legends"
                       TextColor="#A292C4"
                       FontSize="12" />
            </VerticalStackLayout>

            <!-- View Mode Switcher Button (Grid / List) -->
            <Border Grid.Column="1"
                    Stroke="#4A3477"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="#21143D"
                    Padding="10,6"
                    VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleViewModeCommand}" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="6">
                    <Label Text="{Binding ViewModeIcon}"
                           TextColor="#E0AAFF"
                           FontSize="14"
                           VerticalOptions="Center" />
                    <Label Text="{Binding ViewModeLabel}"
                           TextColor="#E0AAFF"
                           FontSize="12"
                           FontAttributes="Bold"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <!-- 2. Search Bar -->
        <Border Grid.Row="1"
                Margin="16,8,16,6"
                Stroke="#3C2866"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 14"
                BackgroundColor="#1B1135"
                Padding="6,2">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                <Label Grid.Column="0"
                       Text="🔍"
                       TextColor="#9D4EDD"
                       FontSize="14"
                       Margin="10,0,4,0"
                       VerticalOptions="Center" />
                <SearchBar Grid.Column="1"
                           Text="{Binding SearchText}"
                           Placeholder="Search characters, series, powers..."
                           PlaceholderColor="#8572A8"
                           TextColor="#FFFFFF"
                           BackgroundColor="Transparent"
                           CancelButtonColor="#C77DFF"
                           FontSize="13" />
            </Grid>
        </Border>

        <!-- 3. Category Filter Chips (Horizontal Scroll) -->
        <ScrollView Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never"
                    Padding="16,4,16,6">
            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding CategoryFilters}"
                                   Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:CategoryFilterItem">
                        <Border Stroke="{Binding StrokeColor}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 16"
                                BackgroundColor="{Binding BgColor}"
                                Padding="14,7">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=SelectCategoryCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding Name}"
                                   TextColor="{Binding TxtColor}"
                                   FontSize="12"
                                   FontAttributes="Bold" />
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- 4. Roster Counter & Filter Status -->
        <Grid Grid.Row="3"
              Margin="18,4,18,6"
              ColumnDefinitions="*,Auto">
            <Label Grid.Column="0"
                   Text="{Binding CharacterCountText}"
                   TextColor="#9B8BB8"
                   FontSize="12"
                   FontAttributes="Bold"
                   VerticalOptions="Center" />
            
            <Label Grid.Column="1"
                   Text="Tap a character for full dossier"
                   TextColor="#6E5D8E"
                   FontSize="11"
                   VerticalOptions="Center" />
        </Grid>

        <!-- 5. CollectionView for Anime Characters -->
        <CollectionView Grid.Row="4"
                        Margin="14,2,14,10"
                        ItemsSource="{Binding FilteredCharacters}"
                        ItemsLayout="{Binding CurrentItemsLayout}"
                        SelectedItem="{Binding SelectedCharacter, Mode=TwoWay}"
                        SelectionMode="Single"
                        ItemSizingStrategy="MeasureFirstItem">

            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Spacing="12"
                                     Padding="30">
                    <Border Stroke="#4B327D"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 36"
                            BackgroundColor="#22153F"
                            HeightRequest="72"
                            WidthRequest="72"
                            HorizontalOptions="Center">
                        <Label Text="🔍"
                               FontSize="30"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    <Label Text="No Characters Found"
                           TextColor="#FFFFFF"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalOptions="Center" />
                    <Label Text="Try adjusting your search query or selecting a different category."
                           TextColor="#9B8BB8"
                           FontSize="13"
                           HorizontalTextAlignment="Center"
                           HorizontalOptions="Center" />
                    <Button Text="Reset All Filters"
                            Command="{Binding RefreshCommand}"
                            TextColor="#FFFFFF"
                            BackgroundColor="#7B2CBF"
                            CornerRadius="12"
                            HeightRequest="42"
                            FontAttributes="Bold"
                            Margin="0,8,0,0"
                            HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:AnimeCharacter">
                    <Border Stroke="#3B2666"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16"
                            Margin="0,0,0,12"
                            Shadow="{Shadow Brush='#000000', Offset='0,4', Radius=8, Opacity=0.45}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#231644" Offset="0.0" />
                                <GradientStop Color="#180E2F" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=SelectCharacterCommand}"
                                                  CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>

                        <VerticalStackLayout Spacing="0">
                            
                            <!-- Character Image Container with Category Badge Overlay -->
                            <Grid HeightRequest="200">
                                <!-- Image with Rounded Top Corners, AspectFit ensures full image is visible -->
                                <Border StrokeThickness="0"
                                        StrokeShape="RoundRectangle 15,15,0,0"
                                        BackgroundColor="#180E2F">
                                    <Image Source="{Binding Image}"
                                           Aspect="AspectFit"
                                           HorizontalOptions="Fill"
                                           VerticalOptions="Fill" />
                                </Border>

                                <!-- Bottom subtle gradient over image -->
                                <BoxView VerticalOptions="End"
                                         HeightRequest="55">
                                    <BoxView.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0.0" />
                                            <GradientStop Color="#D9180E2F" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </BoxView.Background>
                                </BoxView>

                                <!-- Category Chip on top right -->
                                <Border HorizontalOptions="End"
                                        VerticalOptions="Start"
                                        Margin="8"
                                        BackgroundColor="#CC1C1036"
                                        Stroke="#7B2CBF"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 10"
                                        Padding="8,3">
                                    <Label Text="{Binding Category}"
                                           TextColor="#E0AAFF"
                                           FontSize="10"
                                           FontAttributes="Bold" />
                                </Border>
                            </Grid>

                            <!-- Character Information Section -->
                            <VerticalStackLayout Padding="12,10,12,12" Spacing="5">
                                
                                <!-- Name -->
                                <Label Text="{Binding Name}"
                                       TextColor="#FFFFFF"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       LineBreakMode="TailTruncation" />

                                <!-- Anime Series & Role -->
                                <Label Text="{Binding AnimeSeries}"
                                       TextColor="#C77DFF"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       LineBreakMode="TailTruncation" />

                                <Label Text="{Binding Role}"
                                       TextColor="#A89AC5"
                                       FontSize="10"
                                       LineBreakMode="TailTruncation" />

                                <!-- Short Description -->
                                <Label Text="{Binding ShortDescription}"
                                       TextColor="#C6BED8"
                                       FontSize="11"
                                       LineHeight="1.2"
                                       MaxLines="2"
                                       LineBreakMode="TailTruncation"
                                       Margin="0,2,0,4" />

                                <!-- Bottom Divider and Link -->
                                <BoxView HeightRequest="1"
                                         Color="#2F1E52"
                                         Margin="0,2,0,4" />

                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0"
                                           Text="View Dossier"
                                           TextColor="#C77DFF"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center" />
                                    <Label Grid.Column="1"
                                           Text="→"
                                           TextColor="#E0AAFF"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center" />
                                </Grid>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
