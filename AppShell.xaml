<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AnimeGallery.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:AnimeGallery"
    xmlns:views="clr-namespace:AnimeGallery.Views"
    Title="Anime Characters"
    Shell.NavBarIsVisible="False"
    Shell.BackgroundColor="#140D26"
    Shell.ForegroundColor="#FFFFFF"
    Shell.TitleColor="#FFFFFF">

    <!-- Loading screen shown first -->
    <ShellContent
        x:Name="LoadingContent"
        Title="Loading"
        ContentTemplate="{DataTemplate views:LoadingPage}"
        Route="LoadingPage" />

    <!-- Main gallery page -->
    <ShellContent
        x:Name="MainContent"
        Title="Characters"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

</Shell>
